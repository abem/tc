#!/usr/bin/env -S uv run python3
"""Transcribe CLI - config/config.yaml対応の音声文字起こしツール。"""

import argparse
import os
import sys
import tempfile
from pathlib import Path
from typing import Any, Dict, Optional

import warnings
import yaml

try:
    from dotenv import load_dotenv

    load_dotenv()
except ImportError:
    pass

warnings.filterwarnings("ignore", category=UserWarning, module="transformers")
warnings.filterwarnings("ignore", category=FutureWarning, module="transformers")
os.environ["TRANSFORMERS_VERBOSITY"] = "error"

PROJECT_ROOT = Path(__file__).parent.absolute()
sys.path.insert(0, str(PROJECT_ROOT))

from core.cli_common import build_output_file, extract_gdrive_file_id, is_google_drive_url, resolve_device, update_whisper_config
from core.config import TranscriptionConfig
from core.logging import get_logger
from core.transcription_interface import UnifiedTranscriber
from handlers import GDriveClient

logger = get_logger(__name__)


def load_config() -> Dict[str, Any]:
    config_path = PROJECT_ROOT / "config" / "config.yaml"
    if not config_path.exists():
        logger.error(f"設定ファイルが見つかりません: {config_path}")
        sys.exit(1)

    with open(config_path, "r", encoding="utf-8") as config_file:
        config = yaml.safe_load(config_file)

    logger.info("設定ファイルを読み込みました")
    return config


def download_from_gdrive(url: str) -> str:
    client = GDriveClient()
    file_id = extract_gdrive_file_id(url)

    with tempfile.NamedTemporaryFile(suffix=".mp3", delete=False) as tmp_file:
        tmp_path = tmp_file.name

    logger.info(f"ファイルをダウンロード中: {file_id}")
    client.download_file(file_id, tmp_path)
    logger.info(f"ダウンロード完了: {tmp_path}")
    return tmp_path


def upload_to_gdrive(local_path: str, original_file_id: str) -> Optional[str]:
    try:
        client = GDriveClient()
        parent_id = client.get_parent_folder_id(original_file_id)
        file_id = client.upload_file(local_path, Path(local_path).name, parent_id)
        return client.get_file_url(file_id)
    except Exception as error:
        logger.error(f"アップロードエラー: {error}")
        return None


def transcribe_audio(audio_path: str, config: Dict[str, Any]) -> str:
    whisper_config = config.get("whisper", {})
    device = resolve_device(whisper_config.get("device", "cuda"))

    transcription_config = TranscriptionConfig(
        model=whisper_config.get("model", "kotoba-tech/kotoba-whisper-v2.2"),
        language=whisper_config.get("language", "ja"),
        device=device,
        beam_size=whisper_config.get("beam_size", 5),
        best_of=whisper_config.get("best_of", 3),
        temperature=whisper_config.get("temperature", 0.1),
    )

    logger.info(
        "文字起こし開始: モデル=%s, 言語=%s, デバイス=%s",
        transcription_config.model,
        transcription_config.language,
        transcription_config.device,
    )

    transcriber = UnifiedTranscriber(transcription_config)
    result = transcriber.transcribe(audio_path, progress_callback=lambda message: print(message))

    logger.info(f"文字起こし完了: {len(result.text)}文字")
    return result.text


def save_result(text: str, output_dir: str = "output") -> str:
    output_path = build_output_file(Path(output_dir))
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(text, encoding="utf-8")
    logger.info(f"結果を保存: {output_path}")
    return str(output_path)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="音声文字起こしツール - Google DriveのURLまたはローカルファイルを文字起こし",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("input", nargs="?", help="Google Drive URLまたはローカルファイルパス（省略時はconfig.yamlのURLを使用）")
    parser.add_argument("--output-dir", default="output", help="出力ディレクトリ（デフォルト: output）")
    parser.add_argument("--no-upload", action="store_true", help="Google Driveへのアップロードをスキップ")
    parser.add_argument("--model", help="使用するモデル（config.yamlの設定を上書き）")
    parser.add_argument("--language", help="言語コード（config.yamlの設定を上書き）")
    parser.add_argument("--device", choices=["cuda", "cpu", "auto"], help="使用するデバイス（config.yamlの設定を上書き）")
    return parser


def main():
    args = build_parser().parse_args()

    config = load_config()
    config = update_whisper_config(config, model=args.model, language=args.language, device=args.device)

    input_source = args.input or config.get("gdrive", {}).get("url")
    if not input_source:
        print("config.yamlにGDriveのURLが設定されていません")
        sys.exit(1)

    is_gdrive_source = is_google_drive_url(input_source)
    original_file_id = extract_gdrive_file_id(input_source) if is_gdrive_source else None
    temp_file = None

    try:
        if is_gdrive_source:
            audio_path = download_from_gdrive(input_source)
            temp_file = audio_path
        else:
            audio_path = input_source
            if not os.path.exists(audio_path):
                logger.error(f"ファイルが見つかりません: {audio_path}")
                sys.exit(1)

        transcribed_text = transcribe_audio(audio_path, config)
        output_path = save_result(transcribed_text, args.output_dir)
        print(f"文字起こし完了: {output_path}")

        if is_gdrive_source and original_file_id and not args.no_upload:
            upload_url = upload_to_gdrive(output_path, original_file_id)
            if upload_url:
                print(f"アップロード完了: {upload_url}")
            else:
                print("アップロードに失敗しました")

        preview = transcribed_text[:500]
        print("\n文字起こし結果（最初の500文字）:")
        print(preview)
        if len(transcribed_text) > 500:
            print(f"... (全{len(transcribed_text)}文字)")

    finally:
        if temp_file and os.path.exists(temp_file):
            os.remove(temp_file)
            logger.info(f"一時ファイルを削除: {temp_file}")


if __name__ == "__main__":
    main()
