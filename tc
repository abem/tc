#!/usr/bin/env -S uv run python3
"""Transcribe CLI - config/config.yaml対応の音声文字起こしツール。"""

import argparse
import os
import sys
from pathlib import Path
from typing import Any, Dict

import yaml

try:
    from dotenv import load_dotenv

    load_dotenv()
except ImportError:
    pass

PROJECT_ROOT = Path(__file__).parent.absolute()
sys.path.insert(0, str(PROJECT_ROOT))

# 警告抑制を統一設定(suppress_warnings.py は import 時に自動で全抑制を実行)
import suppress_warnings  # noqa: F401

from core.cli_common import build_output_file, resolve_device, update_whisper_config
from core.cli_workflow import resolve_input_audio, upload_transcription_result
from core.config import TranscriptionConfig
from core.logging import get_logger
from core.transcription_interface import TranscriptionResult, UnifiedTranscriber
from core.utils import load_context_hints

logger = get_logger(__name__)


def load_config() -> Dict[str, Any]:
    config_path = PROJECT_ROOT / "config" / "config.yaml"
    if not config_path.exists():
        logger.error(f"設定ファイルが見つかりません: {config_path}")
        sys.exit(1)

    with open(config_path, "r", encoding="utf-8") as config_file:
        config = yaml.safe_load(config_file)

    logger.info("設定ファイルを読み込みました")
    return config


def transcribe_audio(audio_path: str, config: Dict[str, Any]) -> TranscriptionResult:
    whisper_config = config.get("whisper", {})
    device = resolve_device(whisper_config.get("device", "cuda"))

    transcription_config = TranscriptionConfig(
        model=whisper_config.get("model", "kotoba-tech/kotoba-whisper-v2.2"),
        language=whisper_config.get("language", "ja"),
        device=device,
        beam_size=whisper_config.get("beam_size", 5),
        best_of=whisper_config.get("best_of", 3),
        temperature=whisper_config.get("temperature", 0.1),
        context=load_context_hints(whisper_config.get("context_file", "config/context_hints.txt")),
        include_timestamps=whisper_config.get("include_timestamps", False),
    )

    logger.info(
        "文字起こし開始: モデル=%s, 言語=%s, デバイス=%s",
        transcription_config.model,
        transcription_config.language,
        transcription_config.device,
    )

    transcriber = UnifiedTranscriber(transcription_config)
    result = transcriber.transcribe(audio_path, progress_callback=lambda message: print(message))

    # チャンク失敗があれば警告表示(長音声分割時に一部欠落の可能性)
    failed = (result.metadata or {}).get("failed_chunks", 0)
    if failed:
        print(f"⚠️  警告: {failed}個のチャンクが失敗し、該当区間に[チャンクN失敗]プレースホルダが挿入されました")

    # 反復ループ検出があれば警告表示(該当区間は再試行後も反復のため破棄)
    repeated = (result.metadata or {}).get("repeated_chunks", 0)
    if repeated:
        print(f"⚠️  警告: {repeated}個のチャンクで反復ループを検出しました(再試行後に解消しなかった区間は[チャンクN反復検出のため破棄]プレースホルダが挿入されています)")

    logger.info(f"文字起こし完了: {len(result.text)}文字")
    return result


def _format_mmss(seconds: float) -> str:
    total = max(0, int(seconds))
    return f"{total // 60:02d}:{total % 60:02d}"


def save_result(result: TranscriptionResult, output_dir: str = "output") -> str:
    """文字起こし結果をテキストファイルに保存する。

    result.metadata["timestamps_included"]がTrueの場合(config.include_timestamps=True
    かつForcedAlignerによる整合に成功した場合)、segments各要素の先頭に[MM:SS]を
    付与する。それ以外(タイムスタンプ未使用/失敗時のフォールバック)は従来どおり
    result.textをそのまま書き出し、既存の出力形式を維持する。
    """
    output_path = build_output_file(Path(output_dir))
    output_path.parent.mkdir(parents=True, exist_ok=True)

    timestamps_included = bool((result.metadata or {}).get("timestamps_included", False))
    if timestamps_included and result.segments:
        lines = [f"[{_format_mmss(seg.start)}] {seg.text}" for seg in result.segments]
        content = "\n".join(lines)
    else:
        content = result.text

    output_path.write_text(content, encoding="utf-8")
    logger.info(f"結果を保存: {output_path}")
    return str(output_path)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="音声文字起こしツール - YouTube URL・Google Drive URLまたはローカルファイルを文字起こし",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("input", nargs="?", help="YouTube URL・Google Drive URLまたはローカルファイルパス（省略時はconfig.yamlのURLを使用）")
    parser.add_argument("--output-dir", default="output", help="出力ディレクトリ（デフォルト: output）")
    parser.add_argument("--no-upload", action="store_true", help="Google Driveへのアップロードをスキップ")
    parser.add_argument("--model", help="使用するモデル（config.yamlの設定を上書き）")
    parser.add_argument("--language", help="言語コード（config.yamlの設定を上書き）")
    parser.add_argument("--device", choices=["cuda", "cpu", "auto"], help="使用するデバイス（config.yamlの設定を上書き）")
    parser.add_argument("--folder-id", help="アップロード先Google DriveフォルダID（省略時は元ファイルと同じフォルダ）")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="設定読み込み・入力解決までを行い、実際の文字起こしは行わずに終了する（起動確認用）",
    )
    return parser


def main():
    args = build_parser().parse_args()

    config = load_config()
    config = update_whisper_config(config, model=args.model, language=args.language, device=args.device)

    input_source = args.input or config.get("gdrive", {}).get("url")
    if not input_source:
        print("config.yamlにGDriveのURLが設定されていません")
        sys.exit(1)

    try:
        resolution = resolve_input_audio(
            input_source, Path(args.output_dir), ensure_yt_dlp=True, on_status=print
        )
    except ValueError as error:
        logger.error(str(error))
        sys.exit(1)

    audio_path = resolution.local_audio_path
    # GDriveClient.download()はStorageBackendインターフェース経由で常に
    # NamedTemporaryFile(delete=False)へ保存する。resolve_input_audioの
    # is_temp_fileはgdriveでは常にFalseだが、実体は一時ファイルであるため
    # source_type=="gdrive"も削除対象に含める（tcの従来挙動を維持）。
    needs_cleanup = resolution.is_temp_file or resolution.source_type == "gdrive"

    if args.dry_run:
        print(f"ドライラン: 起動確認OK (input={audio_path})")
        if needs_cleanup and os.path.exists(audio_path):
            if resolution.youtube_handler:
                resolution.youtube_handler.cleanup_temp_file(audio_path)
            else:
                os.remove(audio_path)
                logger.info(f"一時ファイルを削除: {audio_path}")
        return

    try:
        result = transcribe_audio(audio_path, config)
        transcribed_text = result.text
        output_path = save_result(result, args.output_dir)
        print(f"文字起こし完了: {output_path}")

        if resolution.source_type in {"youtube", "gdrive"} and not args.no_upload:
            # フォルダID決定: 引数 > config.yaml > 元ファイルと同じフォルダ
            folder_id = args.folder_id or config.get("gdrive", {}).get("upload_folder_id")
            upload_url = upload_transcription_result(
                source_type=resolution.source_type,
                original_source=resolution.original_source,
                output_file=Path(output_path),
                metadata=resolution.metadata,
                folder_id=folder_id,
            )
            if upload_url:
                print(f"アップロード完了: {upload_url}")
            else:
                print("アップロードに失敗しました")

        preview = transcribed_text[:500]
        print("\n文字起こし結果（最初の500文字）:")
        print(preview)
        if len(transcribed_text) > 500:
            print(f"... (全{len(transcribed_text)}文字)")

    finally:
        if needs_cleanup and os.path.exists(audio_path):
            if resolution.youtube_handler:
                resolution.youtube_handler.cleanup_temp_file(audio_path)
            else:
                os.remove(audio_path)
                logger.info(f"一時ファイルを削除: {audio_path}")


if __name__ == "__main__":
    main()
